# PulseBoard configuration
#
# Every variable below is OPTIONAL — the app runs with no .env file at all,
# because the demo dataset is generated in-process from a fixed seed.
# Copy this file to `.env.local` to override anything.
#
# `.env.local` is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — put nothing sensitive here)
# ---------------------------------------------------------------------------

# Repository URL shown as the "Source" link in the header.
# Omit it and the link is not rendered at all, so no deployment ships a dead
# placeholder.
NEXT_PUBLIC_REPO_URL=https://github.com/<your-username>/pulseboard-analytics

# ---------------------------------------------------------------------------
# Test / CI only
# ---------------------------------------------------------------------------

# Point Playwright at an already-running instance instead of having it build
# and start one. Useful against a deployed preview.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100

# Use a pre-installed Chromium instead of the one Playwright downloads.
# Needed on sandboxed or air-gapped runners.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome
